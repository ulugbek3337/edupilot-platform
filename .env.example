# Copy this file to .env for local development.
# Never commit the real .env file or production secrets.

DB_NAME=edupilot
DB_USERNAME=eduflow
DB_PASSWORD=CHANGE_THIS_LOCAL_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/edupilot

# Redis must have a strong password. Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_THIS_LOCAL_REDIS_PASSWORD

# Generate a fresh secret locally with:
# openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_GENERATED_LOCALLY
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Exact frontend origins, comma-separated. Do not use * with credentials.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
