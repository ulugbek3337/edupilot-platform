# Copy to .env. Never commit real secrets.
DB_NAME=edupilot
DB_USERNAME=edupilot_app
DB_PASSWORD=CHANGE_THIS_APP_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/edupilot

# Bootstrap-only PostgreSQL superuser; not used by the application.
POSTGRES_ADMIN_USER=edupilot_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_DATABASE_PASSWORD

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_LOCAL_REDIS_PASSWORD
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

JWT_SECRET=REPLACE_WITH_BASE64_SECRET_GENERATED_LOCALLY
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
